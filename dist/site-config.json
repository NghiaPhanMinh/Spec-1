    "<div class=\"editor-file\"><span class=\"syntax-comment\">// PROJECT / 01</span><p class=\"editor-filename\">credits.js</p></div>\n<div class=\"editor-line\"><span class=\"syntax-keyword\">const</span> author = {</div>\n<div class=\"editor-line editor-indent\"><span class=\"syntax-key\">name:</span> <span class=\"syntax-string\">\"Phan Minh Nghia\"</span>,</div>\n<div class=\"editor-line editor-indent\"><span class=\"syntax-key\">student:</span> <span class=\"syntax-string\">\"S4176100\"</span></div>\n<div class=\"editor-line\">};</div>\n<div class=\"editor-line editor-space\"><span class=\"syntax-keyword\">const</span> group = <span class=\"syntax-string\">\"Tên nhóm là gì đây?\"</span>;</div>\n<div class=\"editor-line\"><span class=\"syntax-keyword\">const</span> members = [</div>\n<div class=\"editor-line editor-indent\">Nguyen Tuong Lam <span class=\"syntax-comment\">// s4075107</span></div>\n<div class=\"editor-line editor-indent\">Nguyen Hoang Tue Minh <span class=\"syntax-comment\">// s4183536</span></div>\n<div class=\"editor-line editor-indent\">Nguyen Huynh Hanh - Nhi <span class=\"syntax-comment\">// s4033612</span></div>\n<div class=\"editor-line editor-indent\">Phan Minh Nghia <span class=\"syntax-comment\">// s4176100</span></div>\n<div class=\"editor-line editor-indent\">Phan Le Phuong Uyen <span class=\"syntax-comment\">// s4135480</span></div>\n<div class=\"editor-line\">];</div>\n<div class=\"editor-line editor-space\"><span class=\"syntax-key\">course:</span> <span class=\"syntax-string\">\"COMM2754\"</span></div>\n<div class=\"editor-line editor-indent\">Digital Media Specialisation 1 <span class=\"syntax-comment\">/ 26t3</span></div>\n<div class=\"editor-line editor-space\"><span class=\"syntax-key\">affiliation:</span> RMIT University Vietnam</div>\n<div class=\"editor-line editor-indent\">Saigon South Campus</div><div class=\"editor-line editor-indent\">School of Communications and Design</div><div class=\"editor-line editor-indent\">Digital Media Program</div>",
    "<div class=\"editor-file\"><span class=\"syntax-comment\">// INTENT / 02</span><p class=\"editor-filename\">pause-decision.js</p></div>\n<div class=\"editor-line\"><span class=\"syntax-keyword\">export default</span> {</div>\n<div class=\"editor-line editor-indent syntax-comment\">// THE GOAL</div>\n<div class=\"editor-line editor-indent\"><a class=\"info-goal\" href=\"https://sdgs.un.org/goals/goal5\" target=\"_blank\" rel=\"noopener noreferrer\"><span class=\"info-number\">05</span> Gender<br>Equality</a></div>\n<div class=\"editor-line editor-indent\">Achieve gender equality and empower all women and girls.</div>\n<div class=\"editor-line editor-space editor-indent syntax-comment\">// WHO HOLDS THE POWER?</div>\n<div class=\"editor-line editor-indent info-quote\">“The central question of gender equality is a question of <strong>power.</strong>”</div>\n<div class=\"editor-line editor-indent syntax-comment\">António Guterres, 2019 · <a href=\"https://news.un.org/en/story/2019/03/1034571\" target=\"_blank\" rel=\"noopener noreferrer\">UN News</a></div>\n<div class=\"editor-line editor-space editor-indent syntax-comment\">// CHANGE WHO DECIDES</div>\n<div class=\"editor-line editor-indent info-action\">Pass the mic.<br>Nominate a woman.<br>Change who decides.</div>\n<div class=\"editor-line editor-indent info-context\">SDG 5 calls for women’s full participation in decision-making. When women are absent, pause the decision and make room for their voices.</div>\n<div class=\"editor-line editor-space editor-indent\"><span class=\"syntax-key\">audience:</span> <span class=\"syntax-string\">\"Young adults, 18–25\"</span></div>\n<div class=\"editor-line editor-indent\"><span class=\"syntax-key\">date:</span> <time id=\"current-date\">24 November 2026</time></div><div class=\"editor-line\">};</div>"
