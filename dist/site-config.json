    "\n        <p class=\"info-identity\"><span class=\"info-label\">&lt;name&gt;</span>&nbsp;<a class=\"info-blue\" data-info-effect=\"water\" role=\"button\" tabindex=\"0\">PHAN MINH NGHIA - S4176100</a></p>\n        <p class=\"info-group\"><span class=\"info-label\">&lt;group name&gt;</span>&nbsp;<span>TÊN NHÓM LÀ GÌ ĐÂY?</span></p>\n        <p class=\"info-members\"><span class=\"info-label\">&lt;group members&gt;</span>&nbsp;<a class=\"info-pink\" data-info-effect=\"flowers\" role=\"button\" tabindex=\"0\">NGUYEN TUONG LAM - S4075107</a><br>\n          <a class=\"info-pink\" data-info-effect=\"flowers\" role=\"button\" tabindex=\"0\">NGUYEN HOANG TUE MINH - S4183536</a><br>\n          <a class=\"info-pink\" data-info-effect=\"flowers\" role=\"button\" tabindex=\"0\">NGUYEN HUYNH HANH - NHI S4033612</a><br>\n          <a class=\"info-blue\" data-info-effect=\"water\" role=\"button\" tabindex=\"0\">PHAN MINH NGHIA - S4176100</a><br>\n          <a class=\"info-pink\" data-info-effect=\"flowers\" role=\"button\" tabindex=\"0\">PHAN LE PHUONG UYEN - S4135480</a></p>\n        <p class=\"info-course\"><span class=\"info-label\">&lt;course&gt;</span>&nbsp;<span>COMM2754 | DIGITAL MEDIA SPECIALISATION 1 | 26T3 | THURSDAY 11:30–14:30</span></p>\n        <p class=\"info-affiliation\"><span class=\"info-label\">&lt;affiliation&gt;</span>&nbsp;<span>RMIT UNIVERSITY VIETNAM, SAIGON SOUTH CAMPUS, SCHOOL OF COMMUNICATION AND DESIGN, DIGITAL MEDIA PROGRAM</span></p>",
    "\n        <p class=\"info-sdg\"><span class=\"info-label\">&lt;SDG&gt;</span>&nbsp;<a class=\"info-pink\" data-info-effect=\"flowers\" role=\"button\" tabindex=\"0\">SDG 5 - GENDER EQUALITY. ACHIEVE GENDER EQUALITY AND EMPOWER ALL WOMEN AND GIRLS.</a></p>\n        <div class=\"info-quotation\"><p><span class=\"info-label\">&lt;quote&gt;</span>&nbsp;<span>“THE CENTRAL QUESTION FOR GENDER EQUALITY IS A QUESTION OF POWER.”</span></p><p class=\"info-citation\">ANTÓNIO GUTERRES · 8 MARCH 2018 · <a href=\"https://www.un.org/sg/en/content/sg/statements/2018-03-08/secretary-generals-video-message-for-international-womens-day-scroll-down-for-french-version\" target=\"_blank\" rel=\"noopener noreferrer\">INTERNATIONAL WOMEN’S DAY VIDEO MESSAGE · UNITED NATIONS</a></p></div>\n        <p class=\"info-cta\"><span class=\"info-label\">&lt;CTA&gt;</span>&nbsp;<a class=\"info-blue\" data-info-effect=\"water\" role=\"button\" tabindex=\"0\">PASS THE MIC.</a> <a class=\"info-pink\" data-info-effect=\"flowers\" role=\"button\" tabindex=\"0\">NOMINATE A WOMAN.</a> <a class=\"info-purple\" data-info-effect=\"both\" role=\"button\" tabindex=\"0\">CHANGE WHO DECIDES.</a></p>\n        <p class=\"info-audience\"><span class=\"info-label\">&lt;audience&gt;</span>&nbsp;<span>YOUNG ADULTS (18–25)</span></p>\n        <p class=\"info-meta\"><a href=\"https://sdgs.un.org/goals/goal5\" target=\"_blank\" rel=\"noopener noreferrer\">UN SUSTAINABLE DEVELOPMENT GOAL 5 ↗</a><br><span class=\"info-label\">&lt;date&gt;</span>&nbsp;<time id=\"current-date\">25 NOVEMBER 2026</time></p>"
