    "\n        <p class=\"info-identity\"><span class=\"info-label\">&lt;name&gt;</span> <button class=\"info-emphasis info-blue\" data-info-effect=\"water\" type=\"button\">PHAN MINH NGHIA - S4176100</button></p>\n        <p class=\"info-group\"><span class=\"info-label\">&lt;group name&gt;</span> <span class=\"info-emphasis\">Tên nhóm là gì đây?</span></p>\n        <div class=\"info-block\"><span class=\"info-label\">&lt;group members&gt;</span>\n          <ul class=\"member-list\">\n            <li><button class=\"info-pink\" data-info-effect=\"flowers\" type=\"button\">NGUYEN TUONG LAM - S4075107</button></li>\n            <li><button class=\"info-pink\" data-info-effect=\"flowers\" type=\"button\">NGUYEN HOANG TUE MINH - S4183536</button></li>\n            <li><button class=\"info-pink\" data-info-effect=\"flowers\" type=\"button\">NGUYEN HUYNH HANH - NHI S4033612</button></li>\n            <li><button class=\"info-blue\" data-info-effect=\"water\" type=\"button\">PHAN MINH NGHIA - S4176100</button></li>\n            <li><button class=\"info-pink\" data-info-effect=\"flowers\" type=\"button\">PHAN LE PHUONG UYEN - S4135480</button></li>\n          </ul>\n        </div>\n        <p class=\"info-course\"><span class=\"info-label\">&lt;course&gt;</span> <span class=\"info-emphasis\">COMM2754 | Digital Media Specialisation 1 | 26t3</span></p>\n        <p class=\"info-affiliation\"><span class=\"info-label\">&lt;affiliation&gt;</span> RMIT University Vietnam, Saigon South Campus, School of Communications and Design, Digital Media Program</p>",
    "\n        <p class=\"info-sdg\"><span class=\"info-label\">&lt;SDG&gt;</span> <button class=\"info-emphasis info-pink\" data-info-effect=\"flowers\" type=\"button\">SDG 5 - GENDER EQUALITY<br>ACHIEVE GENDER EQUALITY AND EMPOWER ALL WOMEN AND GIRLS.</button></p>\n        <div class=\"info-block info-quotation\"><span class=\"info-label\">&lt;quote&gt;</span><p>“The central question of gender equality is a question of power.”</p><p class=\"info-citation\">António Guterres, 2019 · <a href=\"https://news.un.org/en/story/2019/03/1034571\" target=\"_blank\" rel=\"noopener noreferrer\">UN News</a></p></div>\n        <div class=\"info-block info-cta\"><span class=\"info-label\">&lt;CTA&gt;</span><p class=\"info-emphasis\"><button class=\"info-blue\" data-info-effect=\"water\" type=\"button\">PASS THE MIC.</button> <button class=\"info-pink\" data-info-effect=\"flowers\" type=\"button\">NOMINATE A WOMAN.</button> <button class=\"info-purple\" data-info-effect=\"both\" type=\"button\">CHANGE WHO DECIDES.</button></p></div>\n        <p class=\"info-audience\"><span class=\"info-label\">&lt;audience&gt;</span> Young adults (18–25)</p>\n        <p class=\"info-meta\"><a href=\"https://sdgs.un.org/goals/goal5\" target=\"_blank\" rel=\"noopener noreferrer\">UN Sustainable Development Goal 5 ↗</a><br><span class=\"info-label\">&lt;date&gt;</span> <time id=\"current-date\">25 November 2026</time></p>"
